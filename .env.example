# =============================================================================
# Farhan MCQ — Backend Environment Variables
# =============================================================================
# Copy this file to `.env` and replace placeholder values before running the API.
#
#   cp .env.example .env
#
# All variables marked [required] are validated at startup via src/config/env.schema.ts.
# Variables marked [optional] are used by maintenance scripts or operational tooling.
# =============================================================================

# -----------------------------------------------------------------------------
# Core runtime [required]
# -----------------------------------------------------------------------------

# Application environment: development | production | test
NODE_ENV=development

# HTTP port the API listens on (default: 3002)
PORT=3002

# PostgreSQL connection string (Prisma)
# Local Docker example:
#   postgresql://postgres:11111111@localhost:5432/farhan-mcq-project?schema=public
# Supabase pooler example:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farhan-mcq-project?schema=public

# Supabase: use session pooler port 5432 (not 6543 transaction pooler) — works with Prisma and db push.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farhan-mcq-project?schema=public

# Redis connection string (cache + BullMQ job queues)
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Authentication & internal security [required]
# -----------------------------------------------------------------------------

# JWT signing secret — minimum 32 characters with high character diversity.
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-use-openssl-rand-hex-32-in-production

# JWT lifetime (format: <number><s|m|h|d>, max 30 days)
JWT_EXPIRES_IN=7d

# Encrypts AI provider keys stored in the database (64 hex characters).
# Generate: openssl rand -hex 32
AI_KEY_ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Shared secret for server-to-server calls from the Next.js frontend (min 32 chars).
# Must match INTERNAL_API_SECRET in frontend/.env.local
# Generate: openssl rand -hex 32
INTERNAL_API_SECRET=change-me-shared-secret-min-32-characters-long

# -----------------------------------------------------------------------------
# Logging [optional — has defaults]
# -----------------------------------------------------------------------------

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# CORS [optional — has defaults]
# -----------------------------------------------------------------------------

# Comma-separated allowed origins. Use * only in development.
# Production must list explicit origins (wildcard is rejected in production).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# Bulk SMS — MiMSMS gateway [required in production only; dev logs OTP to console]
# -----------------------------------------------------------------------------

MIMSMS_API_KEY=your-mimsms-api-key
MIMSMS_USER_NAME=your-mimsms-username
MIMSMS_SENDER_NAME=8801XXXXXXXXX

# -----------------------------------------------------------------------------
# MinIO — S3-compatible object storage (slide generator) [required]
# -----------------------------------------------------------------------------
# Start with: docker compose up -d minio minio-init

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=farhan_minio_admin
MINIO_SECRET_KEY=farhan_minio_secret_key
MINIO_BUCKET=farhan-slides

# -----------------------------------------------------------------------------
# Slide worker [optional]
# -----------------------------------------------------------------------------

# When unset: embedded in the API process during development (npm run dev).
# In production, run the dedicated worker container: docker compose up worker
# EMBED_SLIDE_WORKER=true

# -----------------------------------------------------------------------------
# Maintenance scripts [optional — not validated at API startup]
# -----------------------------------------------------------------------------
# Used by Prisma backfill/seed scripts (npm run db:backfill-explanation-mistral-ai, etc.)

# Comma-separated Mistral API keys for round-robin in batch scripts
MISTRAL_API_KEYS=key-one,key-two,key-three

# Legacy single-key alias (scripts accept MISTRAL_API_KEY or MISTRAL_API_KEYS)
# MISTRAL_API_KEY=your-mistral-api-key

# -----------------------------------------------------------------------------
# Database backup tooling [optional — operational]
# -----------------------------------------------------------------------------
# These variables are referenced by external backup workflows; they are not
# validated by the API env schema.

BACKUP_DIR=backups
USE_SUPABASE_CLI=true
BACKUP_METHOD=supabase
BACKUP_DATA_ONLY=true
SUPABASE_DUMP_USE_COPY=true
BACKUP_KEEP_COUNT=20
PG_DUMP_COMMAND=pg_dump
SUPABASE_COMMAND=supabase
