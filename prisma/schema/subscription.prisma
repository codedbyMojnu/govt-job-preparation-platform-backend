// Subscription & Payment models

enum PaymentMethod {
  BKASH
  NAGAD
  ROCKET
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Package {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(200)
  durationDays Int      @map("duration_days")
  price        Float
  discount     Float    @default(0)
  description  String?  @db.Text
  liveQuota    Int?     @map("live_quota")
  archiveQuota Int?     @map("archive_quota")
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  userPackages UserPackage[]
  transactions PaymentTransaction[]

  @@map("packages")
}

model UserPackage {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  packageId   String   @map("package_id")
  startDate   DateTime @default(now()) @map("start_date")
  endDate     DateTime @map("end_date")
  liveUsed    Int      @default(0) @map("live_used")
  archiveUsed Int      @default(0) @map("archive_used")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  package Package @relation(fields: [packageId], references: [id])

  @@index([userId])
  @@index([endDate])
  @@map("user_packages")
}

model PaymentTransaction {
  id            String        @id @default(cuid())
  userId        String        @map("user_id")
  packageId     String        @map("package_id")
  amount        Float
  paymentMethod PaymentMethod @map("payment_method")
  mobileNumber  String        @db.VarChar(20) @map("mobile_number")
  transactionId String        @db.VarChar(50) @map("transaction_id")
  status        PaymentStatus @default(PENDING)
  adminNote     String?       @db.Text @map("admin_note")
  reviewedAt    DateTime?     @map("reviewed_at")
  reviewedBy    String?       @map("reviewed_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id])
  package Package @relation(fields: [packageId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("payment_transactions")
}
